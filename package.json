{
  "name": "scas-ai-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SCAS AI 116s product launch film - code-generated at 24 FPS",
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "audio": "node audio/synth.mjs",
    "render": "node tools/render.mjs",
    "render:stills": "node tools/render.mjs --stills",
    "encode": "node tools/encode.mjs",
    "verify": "node tools/verify.mjs",
    "calibrate": "node tools/calibrate-portal.mjs",
    "pipeline": "npm run audio && npm run render && npm run encode && npm run verify"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "gsap": "^3.12.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "vite": "^6.0.3"
  }
}
